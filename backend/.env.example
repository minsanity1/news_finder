# Database
DATABASE_URL=sqlite:///./data/news.db

# Gemini API
# 단일 키 사용시:
GOOGLE_API_KEY=AIzaSy...

# 여러 키 사용시 (콤마로 구분, 한도 초과시 자동 전환):
# GOOGLE_API_KEYS=AIzaSy...key1,AIzaSy...key2,AIzaSy...key3

# AI 설정
AI_MODEL=gemini-2.0-flash
AI_MAX_TOKENS=500
AI_BATCH_SIZE=10
AI_DAILY_LIMIT_PER_KEY=1500

# 수집 설정
COLLECT_INTERVAL_MINUTES=60
MAX_NEWS_PER_SOURCE=50

# 서버 설정
HOST=0.0.0.0
PORT=8000
DEBUG=true
